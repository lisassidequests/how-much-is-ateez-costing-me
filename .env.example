# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# From console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Your Telegram user ID. Leave blank on first run, message the bot /start, and it tells you the number.
# Until this is set the bot ignores everyone, so strangers can't spend your credits.
ALLOWED_USER_ID=

# Optional
CLAUDE_MODEL=claude-haiku-5-5
CURRENCY=S$
TIMEZONE=Asia/Singapore
LATE_DAYS=28
# Weekly "still incoming" roundup (text only; use /pending for photos)
DIGEST_DAY=sunday
DIGEST_HOUR=10
DB_PATH=data/ateez.db
# healthchecks.io ping URL (free). Emails you if the bot stops, or if Claude credits run out.
HEALTHCHECK_URL=
